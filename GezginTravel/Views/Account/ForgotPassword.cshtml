@model GezginTravel.DTOs.Auth.ForgotPasswordDto

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-surface rounded-2xl shadow-sm border border-surface-variant p-8">

        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-primary-container text-on-primary-container flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[28px]">lock_reset</span>
            </div>

            <h1 class="text-2xl font-bold text-on-background">
                Şifremi Unuttum
            </h1>

            <p class="text-on-surface-variant mt-2 text-sm">
                Hesabınıza bağlı e-posta adresini girin. Şifre sıfırlama bağlantısı oluşturulsun.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 rounded-lg bg-green-100 text-green-800 px-4 py-3 text-sm">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 rounded-lg bg-red-100 text-red-800 px-4 py-3 text-sm">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["ResetLink"] != null)
        {
            <div class="mb-4 rounded-lg bg-yellow-100 text-yellow-900 px-4 py-3 text-sm">
                <p class="font-bold mb-2">Development Reset Link:</p>

                <a href="@TempData["ResetLink"]"
                   class="underline break-all">
                    @TempData["ResetLink"]
                </a>
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-bold text-on-surface mb-2">
                    E-posta Adresi
                </label>

                <input asp-for="Email"
                       class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 focus:border-primary focus:ring-primary"
                       placeholder="ornek@mail.com" />

                <span asp-validation-for="Email" class="text-error text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full rounded-full bg-primary text-on-primary font-bold py-3 hover:bg-primary-container hover:text-on-primary-container transition-colors">
                Bağlantı Oluştur
            </button>
        </form>

        <div class="text-center mt-6">
            <a asp-controller="Account"
               asp-action="Login"
               class="text-sm font-bold text-primary hover:underline">
                Giriş sayfasına dön
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}