@model GezginTravel.DTOs.Auth.ResetPasswordDto

@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md bg-surface rounded-2xl shadow-sm border border-surface-variant p-8">

        <div class="text-center mb-6">
            <div class="w-14 h-14 rounded-2xl bg-primary-container text-on-primary-container flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-[28px]">password</span>
            </div>

            <h1 class="text-2xl font-bold text-on-background">
                Yeni Şifre Belirle
            </h1>

            <p class="text-on-surface-variant mt-2 text-sm">
                Hesabınız için yeni bir şifre oluşturun.
            </p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

            <div>
                <label asp-for="Password" class="block text-sm font-bold text-on-surface mb-2">
                    Yeni Şifre
                </label>

                <input asp-for="Password"
                       class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 focus:border-primary focus:ring-primary"
                       placeholder="Yeni şifreniz" />

                <span asp-validation-for="Password" class="text-error text-sm"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-bold text-on-surface mb-2">
                    Yeni Şifre Tekrar
                </label>

                <input asp-for="ConfirmPassword"
                       class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-3 focus:border-primary focus:ring-primary"
                       placeholder="Yeni şifrenizi tekrar girin" />

                <span asp-validation-for="ConfirmPassword" class="text-error text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full rounded-full bg-primary text-on-primary font-bold py-3 hover:bg-primary-container hover:text-on-primary-container transition-colors">
                Şifremi Güncelle
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}