@model GezginTravel.ViewModels.Dashboard.Admin.AdminLocation.AdminLocationIndexViewModel

<div class="bg-surface rounded-xl shadow-sm border border-surface-container-high overflow-hidden">

    <div class="p-6 border-b border-surface-container-high bg-surface-container-low flex items-center justify-between gap-4">
        <div>
            <h3 class="text-xl font-bold text-on-background">
                Ülkeler
            </h3>
            <p class="text-sm text-on-surface-variant mt-1">
                Ülkeleri, şehir sayılarını ve blog ilişkilerini yönet.
            </p>
        </div>

        <a asp-controller="AdminLocation"
           asp-action="CreateCountry"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-on-primary font-bold hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-sm whitespace-nowrap">
            <span class="material-symbols-outlined text-[18px]">public</span>
            Ülke Ekle
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[900px]">
            <thead>
                <tr class="bg-surface-container-low border-b border-surface-container-high">
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider">Id</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider">Ülke</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider">Slug</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider text-center">Şehir</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider text-center">Blog</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider">Oluşturulma Tarihi</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider">Durum</th>
                    <th class="px-5 py-4 text-xs text-on-surface-variant uppercase tracking-wider text-right">İşlemler</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-surface-container-high">
                @if (Model.Countries.Any())
                {
                    foreach (var country in Model.Countries)
                    {
                        <tr class="hover:bg-surface-container-lowest transition-colors @(country.IsDeleted ? "opacity-60" : "")">
                            <td class="px-5 py-4 font-bold text-on-surface">
                                @country.Id
                            </td>

                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">public</span>
                                    </div>

                                    <div>
                                        <p class="font-bold text-on-surface">
                                            @country.Name
                                        </p>
                                        <p class="text-xs text-on-surface-variant">
                                            Ülke
                                        </p>
                                    </div>
                                </div>
                            </td>

                            <td class="px-5 py-4 text-sm text-on-surface-variant">
                                @country.Slug
                            </td>

                            <td class="px-5 py-4 text-center">
                                <a asp-controller="AdminLocation"
                                   asp-action="Index"
                                   asp-route-countryId="@country.Id"
                                   asp-route-status="@Model.Status"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-searchText="@Model.SearchText"
                                   class="inline-flex items-center justify-center min-w-10 px-3 py-1 rounded-full bg-secondary-container/30 text-on-secondary-container border border-secondary-container font-bold text-sm">
                                    @country.CityCount
                                </a>
                            </td>

                            <td class="px-5 py-4 text-center">
                                <a asp-controller="AdminBlog"
                                   asp-action="Index"
                                   asp-route-countryId="@country.Id"
                                   class="inline-flex items-center justify-center min-w-10 px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20 font-bold text-sm hover:bg-primary hover:text-on-primary transition-colors">
                                    @country.BlogCount
                                </a>
                            </td>                           

                            <td class="px-5 py-4 text-sm text-on-surface-variant">
                                @country.CreatedDate.ToString("dd.MM.yyyy")
                            </td>

                            <td class="px-5 py-4">
                                @if (country.IsDeleted)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border bg-red-100 text-red-800 border-red-200">
                                        Silindi
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border bg-green-100 text-green-800 border-green-200">
                                        Aktif
                                    </span>
                                }
                            </td>

                            <td class="px-5 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="AdminLocation"
                                       asp-action="EditCountry"
                                       asp-route-id="@country.Id"
                                       class="p-2 text-on-surface-variant hover:text-secondary transition-colors rounded-full hover:bg-surface-container-low"
                                       title="Düzenle">
                                        <span class="material-symbols-outlined text-[20px]">edit</span>
                                    </a>

                                    @if (country.IsDeleted)
                                    {
                                        <form asp-controller="AdminLocation"
                                              asp-action="RestoreCountry"
                                              asp-route-id="@country.Id"
                                              method="post"
                                              class="js-confirm-form"
                                              data-confirm-title="Ülkeyi geri yüklemek istiyor musunuz?"
                                              data-confirm-text="Ülke tekrar aktif hale getirilecektir."
                                              data-confirm-icon="question"
                                              data-confirm-button="Evet, geri yükle"
                                              data-cancel-button="Vazgeç">                                            
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="p-2 text-on-surface-variant hover:text-secondary transition-colors rounded-full hover:bg-secondary-container"
                                                    title="Geri Yükle">
                                                <span class="material-symbols-outlined text-[20px]">settings_backup_restore</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="AdminLocation"
                                              asp-action="DeleteCountry"
                                              asp-route-id="@country.Id"
                                              method="post"
                                              class="js-confirm-form"
                                              data-confirm-title="Ülkeyi silmek istiyor musunuz?"
                                              data-confirm-text="Bu ülkeye bağlı aktif şehir veya blog varsa işlem yapılmayacaktır."
                                              data-confirm-icon="warning"
                                              data-confirm-button="Evet, sil"
                                              data-cancel-button="Vazgeç">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="p-2 text-on-surface-variant hover:text-error transition-colors rounded-full hover:bg-error-container"
                                                    title="Sil">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-5 py-8 text-center text-on-surface-variant">
                            Ülke bulunamadı.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>